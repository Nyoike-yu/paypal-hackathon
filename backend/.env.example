# Database: Supabase Postgres. Use the Session pooler connection string from the Supabase dashboard.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
# Signs login tokens. Generate with: python -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=
# Where the web app is served (PayPal sends buyers back here) and which origins may call the API.
APP_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173

# AI (Penny). https://console.anthropic.com
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

# PayPal. Create a REST app at https://developer.paypal.com (sandbox first).
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_ENV=sandbox
# Webhook id from the PayPal dashboard (event: Checkout order approved). Lets money arrive even if the buyer closes the tab.
PAYPAL_WEBHOOK_ID=
# A sandbox PayPal account that receives merchant payouts for partner-store purchases (needs Payouts enabled on the app).
MERCHANT_PAYOUT_EMAIL=

# Real-store product search and photo search. https://trychannel3.com
CHANNEL3_API_KEY=

# Protects POST /internal/settle-all (optional external cron).
CRON_KEY=
